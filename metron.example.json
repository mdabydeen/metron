{
  "endpoint": "http://localhost:11434/api/chat",
  "model": "qwen2.5-coder:32b",
  "timeout_seconds": 180,
  "stream": true,

  "temperature": 0.1,
  "top_p": 0.95,
  "num_ctx": 16384,

  "max_turns": 10,
  "compact_threshold_bytes": 400,
  "max_history_messages": 60,

  "max_slice_lines": 120,
  "max_line_chars": 500,
  "search_max_matches": 10,
  "search_max_per_file": 2,
  "list_max_entries": 60,
  "max_undo_stack": 20,

  "auto_approve_patches": false,
  "plan_mode_default": false,
  "pre_tool_hook": "",

  "instructions_file": "AGENTS.md",
  "max_instructions_bytes": 4096,
  "max_command_bytes": 4096
}
